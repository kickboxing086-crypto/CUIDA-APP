rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    match /users/{userId} {
      allow read, write: if isValidId(userId);
    }

    match /families/{familyId} {
      allow read, write: if isValidId(familyId);
    }

    match /family_activity_logs/{logId} {
      allow read, write: if isValidId(logId);
    }
  }
}
